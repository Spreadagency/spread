# ═══════════════════════════════════════════════════════════
# استثناء مسار رجوع جوجل من mod_security
#
# ليه؟ جوجل بيرجّع في الـ query:
#   scope=...https://www.googleapis.com/auth/userinfo.email...
#   code=4/0ATsMZ...   ← فيه سلاش
# وده بيستفز قواعد OWASP اللي بتمنع الروابط الخارجية والسلاشات
# المشفّرة، فالسيرفر بيرجّع 403 قبل ما PHP يشتغل.
#
# الاستثناء هنا محصور في المجلد ده بس — باقي الموقع محمي زي ما هو.
# ═══════════════════════════════════════════════════════════

<IfModule mod_security2.c>
    # إلغاء القواعد اللي بتضرب تحديدًا (الأأمن — استثناء محدد مش إيقاف كامل)
    SecRuleRemoveById 931130   # Off-Domain Reference / RFI
    SecRuleRemoveById 931100
    SecRuleRemoveById 931110
    SecRuleRemoveById 930110   # Path Traversal (بسبب السلاش في code)
    SecRuleRemoveById 930120
    SecRuleRemoveById 949110   # Inbound Anomaly Score
    SecRuleRemoveById 980130   # Inbound Anomaly Score (summary)
    SecRuleRemoveById 200002   # Failed to parse request body
    SecRuleRemoveById 200003

    # لو استضافتك بتستخدم COMODO/cPanel rules
    SecRuleRemoveByTag "OWASP_CRS/WEB_ATTACK/RFI"
    SecRuleRemoveByTag "OWASP_CRS/WEB_ATTACK/DIR_TRAVERSAL"
</IfModule>

# النسخة القديمة من mod_security
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
