# Copy to .env.local for local development (never commit real values).
# Backend base URL — HTTPS in release builds. For the Android emulator talking to a local PHP server use http://10.0.2.2:8080
EXPO_PUBLIC_API_URL=https://ai.spreadagency.net
# off = store builds (no selling inside the app) · web = internal/direct builds may open the website checkout
# (also requires the server setting mobile_purchases=web)
EXPO_PUBLIC_PURCHASES=off
