{
  "expo": {
    "name": "Spread AI",
    "slug": "spread-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spreadai",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7FC",
    "ios": {
      "bundleIdentifier": "net.spreadagency.spreadai",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Spread AI يحتاج الوصول للصور علشان ترفع صورة مرجعية للتصميم أو لوجو البراند.",
        "NSPhotoLibraryAddUsageDescription": "Spread AI بيحفظ التصميمات اللي بتعملها في معرض الصور.",
        "NSCameraUsageDescription": "Spread AI يحتاج الكاميرا علشان تصوّر صورة مرجعية للتصميم."
      }
    },
    "android": {
      "package": "net.spreadagency.spreadai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1526",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1526",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Spread AI يحتاج الوصول للصور علشان ترفع صورة مرجعية للتصميم أو لوجو البراند.",
          "cameraPermission": "Spread AI يحتاج الكاميرا علشان تصوّر صورة مرجعية للتصميم.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Spread AI يحتاج الوصول للصور علشان يحفظ التصميمات في المعرض.",
          "savePhotosPermission": "Spread AI بيحفظ التصميمات اللي بتعملها في معرض الصور.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0C87EF"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
