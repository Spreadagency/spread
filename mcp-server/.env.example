# ═══ Spread AI — خادم الـ MCP ═══
# انسخ الملف ده لـ .env (chmod 600) وماترفعوش على GitHub أبدًا.

# ── التشغيل ──
TRANSPORT=http
HOST=127.0.0.1
PORT=3000
# العنوان العام (ورا nginx + HTTPS) — من غير /mcp
MCP_PUBLIC_URL=https://mcp.ai.spreadagency.net
# nginx على نفس الجهاز
TRUST_PROXY=loopback

# ── الـ Internal API بتاع الموقع (الخادم ده مابيكلمش MySQL أبدًا) ──
INTERNAL_API_URL=https://ai.spreadagency.net/internal-api/v1
# نفس INTERNAL_API_TOKEN اللي في includes/config.php (64 حرف)
INTERNAL_API_TOKEN=
INTERNAL_API_TIMEOUT_MS=30000

# ── OAuth 2.1 (موصّل Claude) ──
# اعمله بـ: npm run hash-password   (والباسورد نفسه مابيتكتبش هنا)
MCP_OWNER_PASSWORD_HASH=
# 64 حرف عشوائي: openssl rand -hex 32
MCP_JWT_SECRET=
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000
# تسجيل Claude التلقائي (Dynamic Client Registration)
MCP_ALLOW_DCR=true
# الدومينات المسموح يرجع عليها الـ OAuth
MCP_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# اختياري: عميل ثابت (Claude ← Advanced settings ← OAuth Client ID / Secret) — الـ secret 32 حرف على الأقل
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_DATA_DIR=data

# ── Bearer ثابت (Claude Code · المهام المجدولة · الاختبار) — مفصولين بفاصلة، كل واحد 32 حرف على الأقل ──
MCP_STATIC_TOKENS=

# ── الأدوات ──
# أدوات المسودات (اقتراحات · برومبتات · استايلات · ردود) بتتفعّل في المرحلة 6
MCP_ENABLE_DRAFT_TOOLS=false
MCP_RATE_PER_MIN=240
