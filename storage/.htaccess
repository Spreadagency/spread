Options -Indexes

# Block PHP execution in storage (Apache 2.4 + 2.2 fallback)
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block sensitive file types
<FilesMatch "\.(log|sql|env|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
